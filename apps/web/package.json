    "@context-hub/global-search": "workspace:*",
    "@context-hub/zh-cn": "workspace:*",
    "@context-hub/mcp": "workspace:*",
    "@context-hub/plugins": "workspace:*",
    "@context-hub/prompts": "workspace:*",
    "@context-hub/skills": "workspace:*",
    "@context-hub/skills-sh": "workspace:*",
    "@context-hub/variables": "workspace:*",
    "@context-hub/shadcn-ui": "workspace:*",
    "cn": "^0.4.0",
    "lucide-react": "^1.48.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10",
    "@tailwindcss/vite": "^4",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6",
    "eslint": "^10",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17",
    "typescript": "~6",
    "typescript-eslint": "^8",
    "vite": "^8",
    "vitest": "^5.0.5"
