{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "types": ["node"],
    "paths": {
      "@context-hub/shadcn-ui/*": ["./src/*"]
    }
  },
  "include": ["src", "__test__"],
  "exclude": ["node_modules", "dist"]
}
