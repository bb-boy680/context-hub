{
  "name": "vite-monorepo",
  "version": "0.0.1-beta.2",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo build",
    "build:cli": "pnpm --filter web build && pnpm --filter web build:cli",
    "build:desktop": "pnpm --filter @context-hub/desktop build",
    "dev": "turbo dev",
