                      "name": "Line",
                      "fill": "$body",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "共同点只有一个：都是「内容区」的状态。工具栏和三列之外的东西全都不动 —— 用户在任何一种状态下都还能导入、探索、换工作区。",
                      "lineHeight": 1.6,
                      "fontFamily": "$font-sans",
                      "fontSize": 12,
                      "fontWeight": "normal"
                    }
                  ]
                },
