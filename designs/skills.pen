                      "type": "text",
                      "id": "ghbls",
                      "name": "Text",
                      "fill": "$body",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "详情弹窗的「位置」段永远是完整清单，卡片只是摘要：卡片上放不下的，一个都不能丢。",
                      "lineHeight": 1.5,
                      "fontFamily": "$font-sans",
                      "fontSize": 12.5,
                      "fontWeight": "normal"
                    },
