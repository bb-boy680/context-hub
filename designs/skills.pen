                      "name": "Text",
                      "fill": "$body",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "暗色下描边取卡片底色（$surface-dark-elevated），不用白色 —— 白圈在暗底上会漏光。",
                      "lineHeight": 1.5,
                      "fontFamily": "$font-sans",
                      "fontSize": 12.5,
                      "fontWeight": "normal"
                    }
