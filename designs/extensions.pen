                      "fontFamily": "$font-sans",
                      "fontSize": 13,
                      "fontWeight": "600"
                    },
                    {
                      "type": "text",
                      "id": "luaiT",
                      "name": "Text",
                      "fill": "$body",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "保留 state/ 数据与启用状态；失败保留旧版本、不做半途替换，并把原因写进该扩展的记录里。",
