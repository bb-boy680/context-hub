                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "所以行里显示的是「当前在哪生效」，不是「开/关」。同一个插件只会显示一个生效范围——补集不是「关掉的那部分」，而是别的范围没启用它。",
                      "lineHeight": 1.6,
                      "fontFamily": "$font-sans",
                      "fontSize": 12.5,
                      "fontWeight": "normal"
                    }
