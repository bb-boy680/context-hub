                    {
                      "type": "text",
                      "id": "ckKiW",
                      "name": "Intro",
                      "fill": "$copy",
                      "textGrowth": "fixed-width",
                      "width": 680,
                      "content": "Use this skill when a frontend screen has to read as designed rather than generated. It settles layout, type and color before the first component is written.",
