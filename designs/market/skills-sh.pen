                      "width": 680,
                      "layout": "vertical",
                      "gap": 8,
                      "children": [
                        {
                          "type": "text",
                          "id": "afnEv",
                          "name": "Step",
                          "fill": "$copy",
                          "textGrowth": "fixed-width",
                          "width": 680,
                          "content": "Read the brief and name the one job the screen does.",
                          "lineHeight": 1.6,
                          "fontFamily": "Noto Sans SC",
                          "fontSize": 14
                        },
                        {
                          "type": "text",
                          "id": "Qbr0Q",
                          "name": "Step",
                          "fill": "$copy",
                          "textGrowth": "fixed-width",
                          "width": 680,
                          "content": "Choose a visual direction that follows from the brief, not from a template.",
                          "lineHeight": 1.6,
                          "fontFamily": "Noto Sans SC",
                          "fontSize": 14
                        },
                        {
                          "type": "text",
                          "id": "DKGbG",
                          "name": "Step",
                          "fill": "$copy",
                          "textGrowth": "fixed-width",
                          "width": 680,
                          "content": "Build the page, then cut every element that repeats what the layout already says.",
                          "lineHeight": 1.6,
                          "fontFamily": "Noto Sans SC",
                          "fontSize": 14
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "id": "igF4V",
                      "name": "Rules heading",
                      "fill": "$fg",
                      "content": "Rules",
                      "lineHeight": 1.3,
                      "fontFamily": "Noto Sans SC",
                      "fontSize": 16,
                      "fontWeight": "600"
                    },
                    {
                      "type": "frame",
                      "id": "ju0Nb",
                      "name": "Rules",
                      "width": 680,
                      "layout": "vertical",
                      "gap": 8,
                      "children": [
                        {
                          "type": "text",
                          "id": "hYVVz",
                          "name": "Rule",
                          "fill": "$copy",
                          "textGrowth": "fixed-width",
                          "width": 680,
                          "content": "· One accent. Neutral surfaces. No gradients.",
                          "lineHeight": 1.6,
                          "fontFamily": "Noto Sans SC",
                          "fontSize": 14
                        },
                        {
                          "type": "text",
                          "id": "QJS0f",
                          "name": "Rule",
                          "fill": "$copy",
                          "textGrowth": "fixed-width",
                          "width": 680,
                          "content": "· Type carries the hierarchy; labels do not.",
                          "lineHeight": 1.6,
                          "fontFamily": "Noto Sans SC",
                          "fontSize": 14
                        },
                        {
                          "type": "text",
                          "id": "m0p4j",
                          "name": "Rule",
                          "fill": "$copy",
                          "textGrowth": "fixed-width",
                          "width": 680,
                          "content": "· Every control has hover, focus and disabled states.",
                          "lineHeight": 1.6,
                          "fontFamily": "Noto Sans SC",
                          "fontSize": 14
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "id": "i4dVgJ",
                      "name": "Use when heading",
                      "fill": "$fg",
                      "content": "Use when",
                      "lineHeight": 1.3,
                      "fontFamily": "Noto Sans SC",
                      "fontSize": 16,
                      "fontWeight": "600"
                    },
                    {
                      "type": "frame",
                      "id": "MREtU",
                      "name": "Use cases",
                      "width": 680,
                      "layout": "vertical",
                      "gap": 8,
                      "children": [
                        {
                          "type": "text",
                          "id": "MI93r",
                          "name": "Use case",
                          "fill": "$copy",
                          "textGrowth": "fixed-width",
                          "width": 680,
                          "content": "· A page works but reads like a template.",
                          "lineHeight": 1.6,
                          "fontFamily": "Noto Sans SC",
                          "fontSize": 14,
                          "fontWeight": "normal"
                        },
                        {
                          "type": "text",
                          "id": "XB3KY",
                          "name": "Use case",
                          "fill": "$copy",
                          "textGrowth": "fixed-width",
                          "width": 680,
                          "content": "· A redesign needs a direction, not another coat of paint.",
                          "lineHeight": 1.6,
                          "fontFamily": "Noto Sans SC",
                          "fontSize": 14,
                          "fontWeight": "normal"
                        },
                        {
                          "type": "text",
                          "id": "I8336S",
                          "name": "Use case",
                          "fill": "$copy",
                          "textGrowth": "fixed-width",
                          "width": 680,
                          "content": "· A screen has to ship with its empty, loading and error states.",
                          "lineHeight": 1.6,
                          "fontFamily": "Noto Sans SC",
